# Minecraft Server Configuration
# Copy this file to .env and adjust values as needed

# Paper Server Version (e.g., 1.21.10, 1.21.11)
PAPER_VERSION=1.21.10

# Server Port
MINECRAFT_PORT=8888

# Server Name (MOTD)
SERVER_NAME=Minecraft Server

# Maximum Players
MAX_PLAYERS=20

# Game Difficulty (peaceful, easy, normal, hard)
DIFFICULTY=easy

# Default Game Mode (survival, creative, adventure, spectator)
GAMEMODE=survival

# EULA Acceptance (MUST be set to true to run the server)
EULA=false

# Memory Settings
MEMORY_MIN=1G
MEMORY_MAX=2G

# Plugin URLs (comma separated)
# Example with multiple plugins:
PLUGIN_URLS=https://github.com/EssentialsX/Essentials/releases/download/2.21.2/EssentialsX-2.21.2.jar,https://github.com/EngineHub/WorldEdit/releases/download/7.3.17/worldedit-bukkit-7.3.17.jar

# Force plugin re-download on each start (true/false)
PLUGIN_FORCE_DOWNLOAD=false
